# Supabase (valores publicos, seguros para el cliente: la seguridad real la da RLS)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Habilita /sandbox en un build de producción para probar los juegos sin
# backend, sin código de acceso y sin gastar intentos. Dejalo sin definir
# (o en false) cuando el concurso esté en marcha.
VITE_ENABLE_SANDBOX=false

# Servidor de la pelea online (psy-ws). Sin esto, /sandbox?juego=fight-online
# avisa que falta configurarlo en vez de intentar conectarse a cualquier lado.
# En local, con `./gradlew bootRun` en psy-ws:
VITE_FIGHT_WS_URL=ws://localhost:8080/ws/fight

# Reparto en vivo (/admin/reparto): el mismo psy-ws, en /ws/delivery. Sin esta
# variable se deriva de VITE_FIGHT_WS_URL (cambia /ws/fight por /ws/delivery),
# así que normalmente no hace falta. psy-ws tiene que tener delivery.enabled=true.
# VITE_DELIVERY_WS_URL=ws://localhost:8080/ws/delivery

# Pelea local: dos jugadores en el mismo teclado, para ajustar el juego. No es
# un juego para la comunidad: sin esta variable no aparece en ningún lado, ni
# siquiera en /sandbox. Ponela en true sólo en tu .env local.
VITE_ENABLE_FIGHT_LOCAL=false

# Google Analytics 4. El id de la propiedad (G-…): sin él no se carga Analytics,
# así que en tu .env local dejalo vacío para no ensuciar las métricas reales.
# En Vercel va en Production. Ver src/infrastructure/analytics.
VITE_GA_MEASUREMENT_ID=
# 'true' manda todo en modo debug: se ve en vivo en GA → Administrar → DebugView.
VITE_GA_DEBUG=false
