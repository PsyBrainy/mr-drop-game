{
  "name": "psy-fight-validator",
  "private": true,
  "version": "0.1.0",
  "description": "Re-simula las peleas online guardadas y confirma quién ganó, para el ranking.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --external:pg-native --outfile=dist/validator.cjs",
    "start": "node dist/validator.cjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  }
}
